#!/bin/sh
#
# Start/stop the secure IoT gateway daemon
#

DAEMON=/usr/sbin/gatewayd
PIDFILE=/var/run/gatewayd.pid

case "$1" in
start)
    printf "Starting gatewayd: "
    start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$DAEMON" && echo "OK" || echo "FAIL"
    ;;
stop)
    printf "Stopping gatewayd: "
    start-stop-daemon -K -q -p "$PIDFILE" && rm -f "$PIDFILE" && echo "OK" || echo "FAIL"
    ;;
restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
*)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
